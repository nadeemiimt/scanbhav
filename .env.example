# Ollama server and models already available locally
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=mxbai-embed-large:latest
# Replace with the exact Llama model shown by: ollama list
LLM_MODEL=llama3.2:3b
# How long Ollama keeps the model loaded in memory between requests
OLLAMA_KEEP_ALIVE=30m

# Keep your real key in .env only. Never commit or share that file.
ALPHAVANTAGE_API_KEY=replace_with_your_secret_key
# Seconds between Alpha Vantage requests. Use at least 12 for a free key.
ALPHAVANTAGE_REQUEST_DELAY_SECONDS=12

# Finnhub — economic calendar + analyst recommendations (free tier: 60 calls/min)
# Get a key at https://finnhub.io — store only in .env, never commit.
FINNHUB_API_KEY=
# Webhook secret from Finnhub dashboard (X-Finnhub-Secret header on inbound POSTs)
FINNHUB_WEBHOOK_SECRET=
# Public URL Finnhub should POST to, e.g. https://your-host/api/webhooks/finnhub
FINNHUB_WEBHOOK_PUBLIC_URL=

# Stocktwits production API (HTTP Basic — enterprise; optional fallback)
STOCKTWITS_USERNAME=
STOCKTWITS_PASSWORD=
STOCKTWITS_API_BASE=https://api-gw-prd.stocktwits.com
# Social volume: forum RSS + Yahoo + Google + Finnhub + Alpha Vantage (Reddit OAuth skipped).

# Optional India macro (monthly CPI via data.gov.in; FRED annual CPI backup)
# Register free key: https://data.gov.in/
DATA_GOV_IN_API_KEY=
# Register free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Manual overrides still win when set:
# RBI_REPO_RATE=5.25
# INDIA_CPI_YOY=4.8
# INDIA_GSEC_10Y=6.9

# Chroma database and collection
CHROMA_PATH=./data/chroma
COLLECTION_NAME=stock_books
# Append-only GenAI stock memos (separate collection)
INSIGHTS_COLLECTION=stock_insights

# --- GenAI deep research (configurable; swap providers freely) ---
# ollama | cursor | openai | openai_compatible | anthropic
GENAI_PROVIDER=ollama
# Examples:
#   ollama: llama3.2:3b
#   cursor: composer-2.5  OR  cursor-grok-4.5-medium (maps to API id grok-4.5 + params)
#   openai: gpt-4o-mini
#   anthropic: claude-sonnet-4-20250514
GENAI_MODEL=llama3.2:3b

# Cursor Agent / Cloud Agents API (Composer 2.5 / Grok 4.5)
# Works via HTTPS api.cursor.com (Python 3.9 OK). Optional cursor-sdk needs Python >= 3.10.
CURSOR_API_KEY=
CURSOR_API_BASE=https://api.cursor.com
# Optional: pin durable agent id (otherwise auto-saved under data/cursor_agent_id.txt)
# CURSOR_AGENT_ID=bc-...

# OpenAI or any OpenAI-compatible gateway (OpenRouter, Azure, Claude gateway, …)
OPENAI_API_KEY=
GENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Native Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Logging (backend stdout)
LOG_LEVEL=INFO

# Retrieval / ingestion tuning
CHUNK_SIZE=3200
CHUNK_OVERLAP=400
TOP_K=6

# Personal Advisor — screenshot vision extraction (configurable)
# openai | openai_compatible | cursor | ollama
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o-mini
# For openai / openai_compatible / cursor gateway:
VISION_API_KEY=replace_with_your_vision_api_key
VISION_BASE_URL=https://api.openai.com/v1
# For ollama vision, set:
# VISION_PROVIDER=ollama
# VISION_MODEL=llava

# --- OAuth login (Google · Yahoo · GitHub · Microsoft) ---
# Generate a long random string for production: openssl rand -hex 32
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_JWT_TTL_SECONDS=604800
FRONTEND_URL=http://localhost:5173
AUTH_CALLBACK_BASE=http://127.0.0.1:8000
# Local email sign-in when OAuth keys are not set (disable in production)
AUTH_ALLOW_DEV=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Trading desk (paper / live / autopilot) ---
# paper | live — live also requires arm via UI or API
TRADING_EXECUTION_MODE=paper
# Background autopilot scheduler (watchlist alerts + optional paper sim)
AUTOPILOT_ENABLED=false

# --- Broker APIs (Zerodha / Groww / FYERS) — live LTP + orders ---
# Default provider: stub | zerodha | groww | fyers
BROKER_DEFAULT=stub
# Where THIS process runs:
#   local          = laptop (use BROKER_GATEWAY_URL to reach cloud)
#   gateway_host   = static-IP VM that talks to broker APIs directly
#   direct         = same machine is whitelisted (rare on home broadband)
BROKER_DEPLOYMENT_MODE=local
# Your whitelisted public IP (informational; set on gateway VM)
BROKER_STATIC_IP=
# Local dev: point to gateway on static IP (e.g. http://203.0.113.10:8000)
BROKER_GATEWAY_URL=
# Shared secret between local app and gateway (header X-Broker-Gateway-Secret)
BROKER_GATEWAY_SECRET=

# Zerodha Kite Connect (₹500/mo) — OAuth daily access token
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
# Redirect registered in Kite app (must match exactly)
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/broker/auth/zerodha/callback

# Groww Trade API — requires static IP whitelist in Groww developer portal
# Access token is auto-minted from GROWW_API_KEY + GROWW_API_SECRET when GROWW_ACCESS_TOKEN is unset.
# Set GROWW_DATA_ENABLED=1 only after IP whitelist works; default off (Yahoo → NSE used instead).
GROWW_DATA_ENABLED=0
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=

# FYERS API v3
FYERS_APP_ID=
FYERS_SECRET=
FYERS_ACCESS_TOKEN=
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/broker/auth/fyers/callback

# LTP stream: Zerodha KiteTicker WebSocket starts on API boot when BROKER_DEFAULT=zerodha
# and trading autopilot ltp_stream_enabled=true. Groww/FYERS use fast REST poll instead.
# WebSocket push to UI: ws://127.0.0.1:8000/api/broker/stream/ws
