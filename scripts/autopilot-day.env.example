# Copy to scripts/autopilot-day.env and edit before leaving for the day.
# cp scripts/autopilot-day.env.example scripts/autopilot-day.env

# Prevent Mac sleep until this IST time (24h HH:MM) — default 15:30 per NSE trading day
# Set to 17:30 if you return at 5:30 PM and want the API still running to review trades.
CAFFEINATE_UNTIL=15:30

# Stop the watchdog at this IST time
WATCH_UNTIL=17:30

API_PORT=8000
POLL_SECONDS=30

# Session — leave PICK_MODE empty to use data/trading/config.json
# PICK_MODE=curated_list
# SYMBOLS=RELIANCE.NSE,TCS.NSE,INFY.NSE
# MAX_SPEND=200000
# MAX_PROFIT=30000
# MAX_LOSS=15000
# MAX_CONCURRENT=3

# Set STOP_API=1 to kill uvicorn when watchdog exits
# STOP_API=0
